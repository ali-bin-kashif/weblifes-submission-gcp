# Note: This is an example .env file. Copy it to .env and fill in the values before running the pipeline.

# Gmail IMAP
GMAIL_HOST=imap.gmail.com
GMAIL_PORT=993
GMAIL_EMAIL=your_email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
GMAIL_SUBJECT_FILTER="[E-Com] Daily Sales Export"
GMAIL_SUBJECT_PATTERN="^\[E-Com\] Daily Sales Export\s*[–-]\s*\d{4}-\d{2}-\d{2}$"
GMAIL_CSV_PATTERN="^e_com_sales_\d{8}\.csv$"

# Google Cloud / BigQuery
# Point to your service account key file (local dev only — use Workload Identity on GCP)
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
BQ_PROJECT_ID=your-gcp-project-id
BQ_DATASET_ID=raw
BQ_RAW_TABLE=raw_orders

# Alerting — leave empty to disable all email alerts
# Uses the same Gmail credentials above (SMTP via smtp.gmail.com:587)
ALERT_RECIPIENT_EMAIL=your_alert_recipient@gmail.com